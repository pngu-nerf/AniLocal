# Editor defaults that match `dart format` and the repo's files, so a
# contributor's editor and the formatter never fight. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{c,h}]
# The vendored SQLite amalgamation is not ours to reformat.
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
